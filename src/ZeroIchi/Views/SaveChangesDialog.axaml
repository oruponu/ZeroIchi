<Window x:Class="ZeroIchi.Views.SaveChangesDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroIchi"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <StyleInclude Source="avares://ZeroIchi/Views/DialogStyles.axaml"/>
    </Window.Styles>

    <Border MinWidth="368"
            MaxWidth="468"
            Classes="dialog">
        <DockPanel>
            <StackPanel Margin="24,20" DockPanel.Dock="Top">
                <TextBlock Margin="0,0,0,12"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="ZeroIchi"/>
                <TextBlock Text="変更内容を保存しますか？" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Classes="dialog-footer" DockPanel.Dock="Bottom">
                <Grid ColumnDefinitions="*,8,*,8,*">
                    <Button x:Name="SaveButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Classes="accent"
                            Content="保存する"
                            IsDefault="True"/>
                    <Button x:Name="DiscardButton"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="保存しない"/>
                    <Button x:Name="CancelButton"
                            Grid.Column="4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="キャンセル"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
