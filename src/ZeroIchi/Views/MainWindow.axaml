<Window x:Class="ZeroIchi.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:controls="using:ZeroIchi.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:fs="using:ZeroIchi.Models.FileStructure"
        xmlns:l="using:ZeroIchi.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ZeroIchi.ViewModels"
        Title="{Binding Title}"
        Width="1280"
        Height="720"
        d:DesignHeight="450"
        d:DesignWidth="800"
        x:DataType="vm:MainWindowViewModel"
        Background="Transparent"
        DragDrop.AllowDrop="True"
        ExtendClientAreaTitleBarHeightHint="32"
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/avalonia-logo.ico"
        TransparencyLevelHint="Mica"
        WindowDecorations="Full"
        mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ZeroIchi/Views/StructureTreeTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://ZeroIchi/Views/MenuStyles.axaml"/>
        <StyleInclude Source="avares://ZeroIchi/Views/SearchBarStyles.axaml"/>
        <StyleInclude Source="avares://ZeroIchi/Views/ToolTipStyles.axaml"/>

        <Style Selector="Button.caption-button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.caption-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.caption-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
        </Style>
        <Style Selector="Button.caption-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E6C42B1C"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
        </Style>

        <Style Selector="Border.pane">
            <Setter Property="Background" Value="#4C3A3A3A"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.pane-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>

        <Style Selector="TextBlock#RestoreIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Window[WindowState=Maximized] TextBlock#MaximizeIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Window[WindowState=Maximized] TextBlock#RestoreIcon">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Window[WindowState=Maximized] DockPanel#RootPanel">
            <Setter Property="Margin" Value="8"/>
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Command="{Binding NewFileCommand}" Gesture="Ctrl+N"/>
        <KeyBinding Command="{Binding OpenFileCommand}" Gesture="Ctrl+O"/>
        <KeyBinding Command="{Binding SaveFileCommand}" Gesture="Ctrl+S"/>
        <KeyBinding Command="{Binding SaveAsFileCommand}" Gesture="Ctrl+Shift+S"/>
        <KeyBinding Command="{Binding OpenSearchCommand}" Gesture="Ctrl+F"/>
        <KeyBinding Command="{Binding OpenGoToOffsetCommand}" Gesture="Ctrl+G"/>
        <KeyBinding Command="{Binding ToggleStructureTreeCommand}" Gesture="Ctrl+T"/>
        <KeyBinding Command="{Binding ToggleInspectorCommand}" Gesture="Ctrl+I"/>
        <KeyBinding Command="{Binding ShowSettingsCommand}" Gesture="Ctrl+OemComma"/>
        <KeyBinding Command="{Binding FindNextCommand}" Gesture="F3"/>
        <KeyBinding Command="{Binding FindPreviousCommand}" Gesture="Shift+F3"/>
        <KeyBinding Command="{Binding CloseOverlayCommand}" Gesture="Escape"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <DockPanel x:Name="RootPanel">
            <Grid Height="32"
                  ColumnDefinitions="Auto,*,Auto"
                  DockPanel.Dock="Top">
                <Menu Grid.Column="0" chrome:WindowDecorationProperties.ElementRole="User">
                    <MenuItem Header="{l:Localize MenuFile}">
                        <MenuItem Command="{Binding NewFileCommand}"
                                  Header="{l:Localize MenuFileNew}"
                                  InputGesture="Ctrl+N"/>
                        <MenuItem Command="{Binding OpenFileCommand}"
                                  Header="{l:Localize MenuFileOpen}"
                                  InputGesture="Ctrl+O"/>
                        <MenuItem Command="{Binding SaveFileCommand}"
                                  Header="{l:Localize MenuFileSave}"
                                  InputGesture="Ctrl+S"/>
                        <MenuItem Command="{Binding SaveAsFileCommand}"
                                  Header="{l:Localize MenuFileSaveAs}"
                                  InputGesture="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem Command="{Binding ShowSettingsCommand}"
                                  Header="{l:Localize MenuFileSettings}"
                                  InputGesture="Ctrl+OemComma"/>
                        <Separator/>
                        <MenuItem Command="{Binding ExitCommand}" Header="{l:Localize MenuFileExit}"/>
                    </MenuItem>
                    <MenuItem Header="{l:Localize MenuEdit}">
                        <MenuItem Command="{Binding UndoCommand}"
                                  Header="{l:Localize MenuEditUndo}"
                                  InputGesture="Ctrl+Z"
                                  IsEnabled="{Binding CanUndo}"/>
                        <MenuItem Command="{Binding RedoCommand}"
                                  Header="{l:Localize MenuEditRedo}"
                                  InputGesture="Ctrl+Y"
                                  IsEnabled="{Binding CanRedo}"/>
                        <Separator/>
                        <MenuItem Command="{Binding CutCommand}"
                                  Header="{l:Localize MenuEditCut}"
                                  InputGesture="Ctrl+X"/>
                        <MenuItem Command="{Binding CopyCommand}"
                                  Header="{l:Localize MenuEditCopy}"
                                  InputGesture="Ctrl+C"/>
                        <MenuItem Command="{Binding PasteCommand}"
                                  Header="{l:Localize MenuEditPaste}"
                                  InputGesture="Ctrl+V"/>
                        <Separator/>
                        <MenuItem Command="{Binding SelectAllCommand}"
                                  Header="{l:Localize MenuEditSelectAll}"
                                  InputGesture="Ctrl+A"/>
                        <Separator/>
                        <MenuItem Command="{Binding ToggleInsertModeCommand}"
                                  Header="{l:Localize MenuEditInsertMode}"
                                  InputGesture="Insert"
                                  IsChecked="{Binding IsInsertMode, Mode=OneWay}"
                                  ToggleType="CheckBox"/>
                        <Separator/>
                        <MenuItem Command="{Binding OpenSearchCommand}"
                                  Header="{l:Localize MenuEditFind}"
                                  InputGesture="Ctrl+F"/>
                        <MenuItem Command="{Binding OpenGoToOffsetCommand}"
                                  Header="{l:Localize MenuEditGoTo}"
                                  InputGesture="Ctrl+G"/>
                    </MenuItem>
                    <MenuItem Header="{l:Localize MenuView}">
                        <MenuItem Command="{Binding ToggleStructureTreeCommand}"
                                  Header="{l:Localize MenuViewFileStructure}"
                                  InputGesture="Ctrl+T"
                                  IsChecked="{Binding IsStructureTreeVisible, Mode=OneWay}"
                                  ToggleType="CheckBox"/>
                        <MenuItem Command="{Binding ToggleInspectorCommand}"
                                  Header="{l:Localize MenuViewInspector}"
                                  InputGesture="Ctrl+I"
                                  IsChecked="{Binding IsInspectorVisible, Mode=OneWay}"
                                  ToggleType="CheckBox"/>
                    </MenuItem>
                    <MenuItem Header="{l:Localize MenuHelp}">
                        <MenuItem Command="{Binding ShowAboutCommand}" Header="{l:Localize MenuHelpAbout}"/>
                    </MenuItem>
                </Menu>

                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           IsHitTestVisible="False"
                           Opacity="0.7"
                           Text="{Binding Title}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                            Classes="caption-button"
                            Click="OnMinimizeClick">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Text="&#xE921;"/>
                    </Button>
                    <Button chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                            Classes="caption-button"
                            Click="OnMaximizeRestoreClick">
                        <Panel>
                            <TextBlock x:Name="MaximizeIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Text="&#xE922;"/>
                            <TextBlock x:Name="RestoreIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Text="&#xE923;"/>
                        </Panel>
                    </Button>
                    <Button chrome:WindowDecorationProperties.ElementRole="CloseButton"
                            Classes="caption-button caption-close"
                            Click="OnCloseClick">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Text="&#xE8BB;"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Padding="8,4"
                    DockPanel.Dock="Bottom"
                    IsVisible="{Binding StatusBarPositionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               FontSize="11"
                               Foreground="#A0A0A0"
                               Text="{Binding StatusBarSizeText}"/>
                    <TextBlock Margin="0,0,16,0"
                               DockPanel.Dock="Right"
                               FontSize="11"
                               Foreground="#A0A0A0"
                               Text="{Binding StatusBarFileTypeText}"/>
                    <TextBlock x:Name="InsertModeText"
                               Margin="0,0,16,0"
                               DockPanel.Dock="Right"
                               FontSize="11"
                               Foreground="#A0A0A0"
                               IsVisible="{Binding IsInsertMode}"
                               Text="{l:Localize StatusBarInsertMode}"/>
                    <TextBlock x:Name="OverwriteModeText"
                               Margin="0,0,16,0"
                               DockPanel.Dock="Right"
                               FontSize="11"
                               Foreground="#A0A0A0"
                               IsVisible="{Binding !IsInsertMode}"
                               Text="{l:Localize StatusBarOverwriteMode}"/>
                    <TextBlock Margin="0,0,16,0"
                               DockPanel.Dock="Right"
                               FontSize="11"
                               Foreground="#A0A0A0"
                               IsVisible="{Binding SaveProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding SaveProgressText}"/>
                    <TextBlock FontSize="11"
                               Foreground="#A0A0A0"
                               Text="{Binding StatusBarPositionText}"/>
                </DockPanel>
            </Border>

            <Grid Margin="6,2,6,6" ColumnDefinitions="Auto,*,Auto">
                <Border Width="260"
                        Margin="0,0,6,0"
                        Classes="pane"
                        IsVisible="{Binding IsStructureTreeVisible}">
                    <DockPanel>
                        <DockPanel Margin="8,6" DockPanel.Dock="Top">
                            <TextBlock VerticalAlignment="Center"
                                       DockPanel.Dock="Right"
                                       FontSize="11"
                                       Foreground="#9D9D9D"
                                       IsVisible="{Binding IsStructureParsing}"
                                       Text="{l:Localize StructureParsing}"/>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#D4D4D4"
                                       Text="{l:Localize StructureTitle}"/>
                        </DockPanel>
                        <Border Classes="pane-divider" DockPanel.Dock="Top"/>
                        <ListBox x:Name="StructureTreeList"
                                 AutoScrollToSelectedItem="False"
                                 Background="Transparent"
                                 ItemContainerTheme="{StaticResource StructureTreeItemTheme}"
                                 ItemsSource="{Binding StructureTreeItems}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 SelectedItem="{Binding SelectedStructureItem, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:StructureTreeItem">
                                    <StackPanel Margin="{Binding Indent}"
                                                Orientation="Horizontal"
                                                Spacing="0">
                                        <Button Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Command="{Binding ToggleExpandCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding HasChildren}"
                                                Theme="{StaticResource StructureTreeExpanderTheme}">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="8"
                                                       Text="{Binding ExpandIcon}"
                                                       TextAlignment="Center"/>
                                        </Button>
                                        <Panel Width="16" IsVisible="{Binding !HasChildren}"/>
                                        <TextBlock Margin="2,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontStyle="{Binding FontStyle}"
                                                   Foreground="#D4D4D4"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontStyle="{Binding FontStyle}"
                                                   Foreground="{Binding DescriptionForeground}"
                                                   Text="{Binding Description}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Panel Grid.Column="1">
                    <Border Classes="pane">
                        <ScrollViewer Padding="8"
                                      AllowAutoHide="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      IsVisible="{Binding Document, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      VerticalScrollBarVisibility="Auto">
                            <controls:HexViewControl x:Name="HexView"
                                                     CurrentSearchMatchOffset="{Binding CurrentSearchMatchOffset}"
                                                     CursorPosition="{Binding CursorPosition}"
                                                     DataVersion="{Binding DataVersion}"
                                                     Document="{Binding Document}"
                                                     IsInsertMode="{Binding IsInsertMode}"
                                                     IsReadOnly="{Binding IsSaving}"
                                                     SearchMatchLength="{Binding SearchMatchLength}"
                                                     SearchMatchOffsets="{Binding SearchMatchOffsets}"
                                                     SelectionLength="{Binding SelectionLength}"
                                                     SelectionStart="{Binding SelectionStart}"
                                                     StructureColors="{Binding StructureColors}"/>
                        </ScrollViewer>
                    </Border>

                    <Border x:Name="GoToOffsetBar"
                            Classes="search-bar"
                            IsVisible="{Binding IsGoToOffsetVisible}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="GoToOffsetTextBox"
                                     PlaceholderText="{l:Localize GoToOffsetPlaceholder}"
                                     Text="{Binding GoToOffsetText, Mode=TwoWay}"/>
                            <Border Classes="search-mode-group">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <controls:ModeToggleButton Classes="search-mode"
                                                               Content="Hex"
                                                               FontSize="11"
                                                               IsChecked="{Binding IsHexGoToOffset}"/>
                                    <controls:ModeToggleButton Classes="search-mode"
                                                               Content="Dec"
                                                               FontSize="11"
                                                               IsChecked="{Binding !IsHexGoToOffset}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock MinWidth="36"
                                       Margin="4,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#E05050"
                                       Text="{Binding GoToOffsetError}"
                                       TextAlignment="Center"/>
                            <Button Classes="search-button"
                                    Command="{Binding GoToOffsetCommand}"
                                    ToolTip.Tip="{l:Localize GoToOffsetGo}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Text="&#xE76C;"/>
                            </Button>
                            <Button Classes="search-button"
                                    Command="{Binding CloseGoToOffsetCommand}"
                                    ToolTip.Tip="{l:Localize CloseEsc}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Text="&#xE8BB;"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SearchBar"
                            Classes="search-bar"
                            IsVisible="{Binding IsSearchVisible}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="SearchTextBox"
                                     PlaceholderText="{l:Localize SearchPlaceholder}"
                                     Text="{Binding SearchText, Mode=TwoWay}"/>
                            <Border Classes="search-mode-group">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <controls:ModeToggleButton Classes="search-mode"
                                                               Content="Hex"
                                                               FontSize="11"
                                                               IsChecked="{Binding IsHexSearch}"/>
                                    <controls:ModeToggleButton Classes="search-mode"
                                                               Content="ASCII"
                                                               FontSize="11"
                                                               IsChecked="{Binding !IsHexSearch}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock MinWidth="36"
                                       Margin="4,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Text="{Binding SearchStatusText}"
                                       TextAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center"
                                       Classes="search-busy"
                                       Classes.searching="{Binding IsSearching}"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Text="{l:Localize SearchSearching}"/>
                            <Button Classes="search-button"
                                    Command="{Binding FindPreviousCommand}"
                                    ToolTip.Tip="{l:Localize SearchPrevious}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Text="&#xE70E;"/>
                            </Button>
                            <Button Classes="search-button"
                                    Command="{Binding FindNextCommand}"
                                    ToolTip.Tip="{l:Localize SearchNext}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Text="&#xE70D;"/>
                            </Button>
                            <Button Classes="search-button"
                                    Command="{Binding CloseSearchCommand}"
                                    ToolTip.Tip="{l:Localize CloseEsc}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Text="&#xE8BB;"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Panel>

                <Border Grid.Column="2"
                        Width="220"
                        Margin="6,0,0,0"
                        Classes="pane"
                        IsVisible="{Binding IsInspectorVisible}">
                    <DockPanel>
                        <DockPanel Margin="8,6" DockPanel.Dock="Top">
                            <Border Classes="search-mode-group" DockPanel.Dock="Right">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <controls:ModeToggleButton Classes="search-mode"
                                                               Content="LE"
                                                               FontSize="10"
                                                               IsChecked="{Binding !IsInspectorBigEndian}"/>
                                    <controls:ModeToggleButton Classes="search-mode"
                                                               Content="BE"
                                                               FontSize="10"
                                                               IsChecked="{Binding IsInspectorBigEndian}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#D4D4D4"
                                       Text="{l:Localize InspectorTitle}"/>
                        </DockPanel>

                        <Border Classes="pane-divider" DockPanel.Dock="Top"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="0,4" ItemsSource="{Binding InspectorRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InspectorRow">
                                        <DockPanel Height="20" Margin="8,0">
                                            <TextBlock Width="62"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="#808080"
                                                       Text="{Binding Label}"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="fonts:App#Roboto Mono"
                                                       FontSize="11"
                                                       Foreground="#D4D4D4"
                                                       Text="{Binding Value}"
                                                       TextAlignment="Right"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
        <Border x:Name="ModalOverlay"
                Background="#4D000000"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.083"/>
                </Transitions>
            </Border.Transitions>
        </Border>
    </Panel>

</Window>
