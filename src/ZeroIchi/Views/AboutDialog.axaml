<Window x:Class="ZeroIchi.Views.AboutDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ZeroIchi.Localization"
        Title="{l:Localize AboutTitle}"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <StyleInclude Source="avares://ZeroIchi/Views/DialogStyles.axaml"/>
    </Window.Styles>

    <Border MinWidth="368"
            MaxWidth="468"
            Classes="dialog">
        <DockPanel>
            <StackPanel Margin="24,20" DockPanel.Dock="Top">
                <TextBlock Margin="0,0,0,12"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="ZeroIchi"/>
                <TextBlock x:Name="VersionText"/>
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#C5FFFFFF"
                           Text="Copyright © 2026 oruponu"/>
                <TextBlock FontSize="12"
                           Foreground="#C5FFFFFF"
                           Text="{l:Localize AboutLicenseNotice}"/>
                <HyperlinkButton x:Name="RepositoryLink"
                                 Margin="0,8,0,0"
                                 Padding="0"
                                 Content="github.com/oruponu/ZeroIchi"/>
            </StackPanel>

            <Border Classes="dialog-footer" DockPanel.Dock="Bottom">
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="LicensesButton"
                            HorizontalContentAlignment="Center"
                            Content="{l:Localize AboutLicensesButton}"/>
                    <Button x:Name="OkButton"
                            MinWidth="120"
                            HorizontalContentAlignment="Center"
                            Classes="accent"
                            Content="OK"
                            IsDefault="True"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
