<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#08FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#12FFFFFF"/>
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ButtonBorderBrush"/>
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ButtonBorderBrush"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C5FFFFFF"/>

        <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource SystemAccentColorLight2}"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver"
                         Opacity="0.9"
                         Color="{DynamicResource SystemAccentColorLight2}"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed"
                         Opacity="0.8"
                         Color="{DynamicResource SystemAccentColorLight2}"/>
        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#14FFFFFF"/>
        <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="AccentButtonBorderBrush"/>
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000"/>
        <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="AccentButtonForeground"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#80000000"/>

        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{DynamicResource SystemAccentColorLight3}"/>
        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver"
                         Opacity="0.8"
                         Color="{DynamicResource SystemAccentColorLight3}"/>
        <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{DynamicResource SystemAccentColorLight2}"/>
    </Styles.Resources>

    <Style Selector="Border.dialog">
        <Setter Property="Margin" Value="16"/>
        <Setter Property="Background" Value="#2B2B2B"/>
        <Setter Property="BorderBrush" Value="#66757575"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="0 8 32 0 #60000000"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.dialog-footer">
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="Background" Value="#202020"/>
        <Setter Property="BorderBrush" Value="#19000000"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="0,0,7,7"/>
    </Style>
</Styles>
