<Window x:Class="ZeroIchi.Views.LicensesDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ZeroIchi.Models"
        xmlns:views="using:ZeroIchi.Views"
        Title="ライセンス"
        Width="800"
        Height="560"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ZeroIchi/Views/StructureTreeTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ControlTheme x:Key="NoticeListItemTheme"
                          BasedOn="{StaticResource StructureTreeItemTheme}"
                          TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,6"/>
            </ControlTheme>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://ZeroIchi/Views/DialogStyles.axaml"/>
    </Window.Styles>

    <Border Classes="dialog">
        <DockPanel>
            <StackPanel Margin="24,20,24,16" DockPanel.Dock="Top">
                <TextBlock Margin="0,0,0,8"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="ライセンス"/>
                <TextBlock x:Name="PreambleText"
                           FontSize="12"
                           Foreground="#C5FFFFFF"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Classes="dialog-footer" DockPanel.Dock="Bottom">
                <Button x:Name="CloseButton"
                        MinWidth="120"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        Classes="accent"
                        Content="閉じる"
                        IsDefault="True"/>
            </Border>

            <Grid ColumnDefinitions="220,*">
                <Border Grid.Column="0"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="0,1,1,0">
                    <ListBox x:Name="NoticeList"
                             Background="Transparent"
                             ItemContainerTheme="{StaticResource NoticeListItemTheme}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ThirdPartyNotice">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Name, Converter={x:Static views:NoticeNameConverters.SplitIntoWords}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="11"
                                               Foreground="#C5FFFFFF"
                                               IsVisible="{Binding License, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               Text="{Binding License}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="1"
                        Background="#1C1C1C"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="0,1,0,0">
                    <TextBox x:Name="BodyText"
                             AcceptsReturn="True"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="fonts:App#Roboto Mono"
                             FontSize="12"
                             IsReadOnly="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
