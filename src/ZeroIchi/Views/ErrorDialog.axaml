<Window x:Class="ZeroIchi.Views.ErrorDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroIchi"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <StyleInclude Source="avares://ZeroIchi/Views/DialogStyles.axaml"/>
    </Window.Styles>

    <Border MinWidth="368"
            MaxWidth="468"
            Classes="dialog">
        <DockPanel>
            <StackPanel Margin="24,20" DockPanel.Dock="Top">
                <TextBlock Margin="0,0,0,12"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="ZeroIchi"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#C5FFFFFF"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Classes="dialog-footer" DockPanel.Dock="Bottom">
                <Button x:Name="OkButton"
                        MinWidth="120"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        Classes="accent"
                        Content="OK"
                        IsDefault="True"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
