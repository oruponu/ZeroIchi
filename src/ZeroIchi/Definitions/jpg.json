{
  "name": "JPEG",
  "extensions": ["jpg", "jpeg", "jpe", "jfif"],
  "magic": "FF D8 FF",
  "endian": "big",
  "fields": [
    { "id": "soi", "name": "SOI", "type": "bytes", "size": 2 },
    {
      "id": "segments",
      "name": "Segments",
      "type": "repeat",
      "until": "eof",
      "nameTemplate": "${segment}",
      "fields": [
        { "id": "fill", "name": "Fill Bytes", "type": "scan" },
        { "id": "marker", "name": "Marker", "type": "uint16" },
        {
          "id": "segment",
          "name": "Segment",
          "type": "match",
          "on": "marker",
          "cases": [
            { "name": "TEM", "range": [65281, 65281] },
            {
              "name": "SOF0 (Baseline DCT)",
              "range": [65472, 65472],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                {
                  "id": "header",
                  "name": "Frame Header",
                  "type": "group",
                  "size": "length-2",
                  "fields": [
                    { "id": "precision", "name": "Sample Precision", "type": "uint8" },
                    { "id": "height", "name": "Height", "type": "uint16" },
                    { "id": "width", "name": "Width", "type": "uint16" },
                    { "id": "componentCount", "name": "Component Count", "type": "uint8" },
                    { "id": "components", "name": "Components", "type": "bytes", "size": "rest" }
                  ]
                }
              ]
            },
            {
              "name": "SOF1 (Extended Sequential DCT)",
              "range": [65473, 65473],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                {
                  "id": "header",
                  "name": "Frame Header",
                  "type": "group",
                  "size": "length-2",
                  "fields": [
                    { "id": "precision", "name": "Sample Precision", "type": "uint8" },
                    { "id": "height", "name": "Height", "type": "uint16" },
                    { "id": "width", "name": "Width", "type": "uint16" },
                    { "id": "componentCount", "name": "Component Count", "type": "uint8" },
                    { "id": "components", "name": "Components", "type": "bytes", "size": "rest" }
                  ]
                }
              ]
            },
            {
              "name": "SOF2 (Progressive DCT)",
              "range": [65474, 65474],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                {
                  "id": "header",
                  "name": "Frame Header",
                  "type": "group",
                  "size": "length-2",
                  "fields": [
                    { "id": "precision", "name": "Sample Precision", "type": "uint8" },
                    { "id": "height", "name": "Height", "type": "uint16" },
                    { "id": "width", "name": "Width", "type": "uint16" },
                    { "id": "componentCount", "name": "Component Count", "type": "uint8" },
                    { "id": "components", "name": "Components", "type": "bytes", "size": "rest" }
                  ]
                }
              ]
            },
            {
              "name": "DHT",
              "range": [65476, 65476],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "JPG (Reserved)",
              "range": [65480, 65480],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "DAC",
              "range": [65484, 65484],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "SOFn",
              "range": [65475, 65487],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                {
                  "id": "header",
                  "name": "Frame Header",
                  "type": "group",
                  "size": "length-2",
                  "fields": [
                    { "id": "precision", "name": "Sample Precision", "type": "uint8" },
                    { "id": "height", "name": "Height", "type": "uint16" },
                    { "id": "width", "name": "Width", "type": "uint16" },
                    { "id": "componentCount", "name": "Component Count", "type": "uint8" },
                    { "id": "components", "name": "Components", "type": "bytes", "size": "rest" }
                  ]
                }
              ]
            },
            {
              "name": "RSTn",
              "range": [65488, 65495],
              "fields": [
                { "id": "scanData", "name": "Scan Data", "type": "scan" }
              ]
            },
            { "name": "SOI", "range": [65496, 65496] },
            { "name": "EOI", "range": [65497, 65497] },
            {
              "name": "SOS",
              "range": [65498, 65498],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                {
                  "id": "header",
                  "name": "Scan Header",
                  "type": "group",
                  "size": "length-2",
                  "fields": [
                    { "id": "componentCount", "name": "Component Count", "type": "uint8" },
                    { "id": "componentSpecs", "name": "Component Specs", "type": "bytes", "size": "rest-3" },
                    { "id": "spectralStart", "name": "Spectral Selection Start", "type": "uint8" },
                    { "id": "spectralEnd", "name": "Spectral Selection End", "type": "uint8" },
                    { "id": "approximation", "name": "Successive Approximation", "type": "uint8" }
                  ]
                },
                { "id": "scanData", "name": "Scan Data", "type": "scan" }
              ]
            },
            {
              "name": "DQT",
              "range": [65499, 65499],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "DNL",
              "range": [65500, 65500],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "DRI",
              "range": [65501, 65501],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                {
                  "id": "body",
                  "name": "Restart Definition",
                  "type": "group",
                  "size": "length-2",
                  "fields": [
                    { "id": "restartInterval", "name": "Restart Interval", "type": "uint16" }
                  ]
                }
              ]
            },
            {
              "name": "DHP",
              "range": [65502, 65502],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "EXP",
              "range": [65503, 65503],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "APP0 (JFIF)",
              "range": [65504, 65504],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                {
                  "id": "header",
                  "name": "JFIF Header",
                  "type": "group",
                  "size": "length-2",
                  "fields": [
                    { "id": "identifier", "name": "Identifier", "type": "text", "size": 5 },
                    { "id": "versionMajor", "name": "Version Major", "type": "uint8" },
                    { "id": "versionMinor", "name": "Version Minor", "type": "uint8" },
                    { "id": "densityUnits", "name": "Density Units", "type": "uint8" },
                    { "id": "xDensity", "name": "X Density", "type": "uint16" },
                    { "id": "yDensity", "name": "Y Density", "type": "uint16" },
                    { "id": "thumbnailWidth", "name": "Thumbnail Width", "type": "uint8" },
                    { "id": "thumbnailHeight", "name": "Thumbnail Height", "type": "uint8" },
                    { "id": "thumbnailData", "name": "Thumbnail Data", "type": "bytes", "size": "rest" }
                  ]
                }
              ]
            },
            {
              "name": "APP1",
              "range": [65505, 65505],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "APPn",
              "range": [65506, 65519],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "JPGn",
              "range": [65520, 65533],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "payload", "name": "Payload", "type": "bytes", "size": "length-2" }
              ]
            },
            {
              "name": "COM",
              "range": [65534, 65534],
              "fields": [
                { "id": "length", "name": "Length", "type": "uint16" },
                { "id": "comment", "name": "Comment", "type": "text", "size": "length-2" }
              ]
            },
            { "name": "Unknown Segment", "range": [65280, 65535] }
          ]
        }
      ]
    }
  ]
}
