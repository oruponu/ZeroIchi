root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,manifest,json,yml,yaml,ksy,kst}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Imported third-party files keep their original formatting
[tests/ZeroIchi.Tests/KaitaiConformance/{formats,spec,src}/**]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[tools/MimeRuleGenerator/tika/{tika-mimetypes.xml,LICENSE.txt,NOTICE.txt}]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[src/ZeroIchi/Assets/Fonts/**]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
